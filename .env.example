# Database
DATABASE_URL="postgresql://sams:sams_dev_password@localhost:5432/sams_dev"
DIRECT_URL="postgresql://sams:sams_dev_password@localhost:5432/sams_dev"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-here-min-32-chars"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Redis (Upstash or local)
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# File Storage (AWS S3 or Cloudflare R2)
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="sams-uploads"
STORAGE_ACCESS_KEY_ID="your-access-key"
STORAGE_SECRET_ACCESS_KEY="your-secret-key"
STORAGE_ENDPOINT="https://your-r2-endpoint.r2.cloudflarestorage.com"
STORAGE_PUBLIC_URL="https://your-cdn-domain.com"

# Payments
PAYSTACK_SECRET_KEY="sk_test_your-paystack-secret"
PAYSTACK_PUBLIC_KEY="pk_test_your-paystack-public"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-your-flutterwave-secret"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-your-flutterwave-public"

# Email (Resend)
RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="SAMS <noreply@yourschool.com>"

# SMS (Termii)
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="SAMS"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SAMS"

# Cron (generate a random secret: openssl rand -hex 32)
CRON_SECRET="your-cron-secret-here"

# Monitoring (optional)
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"
NEXT_PUBLIC_POSTHOG_KEY="phc_your-posthog-key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
